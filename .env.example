# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore.

# --- Orchestrator reasoning engine ---
# Required for real runs (--objective, --anthropic-smoke-test). NOT required
# for --dry-run, which works with zero credentials (it uses a canned example
# draft instead of a real LLM call, clearly labeled "WOULD DRAFT" in output).
ANTHROPIC_API_KEY=

# Model used by the orchestrator and outreach drafting. Override if needed.
ORCHESTRATOR_MODEL=claude-sonnet-5

# --- Apollo.io (real REST API, not the MCP connector) ---
# Get this from https://developer.apollo.io -> API Keys.
# Required for real runs (--objective, --apollo-smoke-test). NOT required
# for --dry-run, which uses bundled example data instead (clearly labeled
# "WOULD SEARCH" in output).
APOLLO_API_KEY=

# --- Database ---
JWALT_DB_PATH=data/leads.db

# --- Logging ---
JWALT_LOG_LEVEL=INFO
JWALT_LOG_PATH=data/agent.log

# --- Not yet integrated (planned, see README "What is still missing") ---
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GMAIL_SENDER_ADDRESS=
# CRM_API_KEY=
